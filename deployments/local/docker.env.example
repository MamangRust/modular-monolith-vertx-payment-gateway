# =============================================================================
# vertx-payment-gateway — Docker Compose environment template
# Copy to `docker.env` next to docker-compose.yml and fill in real values.
#   cp docker.env.example docker.env
# Used via `env_file: ./docker.env` in deployments/local/docker-compose.yml.
# =============================================================================

APP_ENV=docker

# ── Database ─────────────────────────────────────────────────────────────────
DB_DRIVER=pgx
DB_HOST=pgbouncer
# DB_HOST=localhost
DB_HOST_MIGRATE=postgres
DB_PORT=5432
DB_USERNAME=change-me
DB_PASSWORD=change-me
DB_NAME=PAYMENT_GATEWAY

DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m

# ── Redis (per-service hosts) ────────────────────────────────────────────────
REDIS_HOST_APIGATEWAY=redis-apigateway
REDIS_PORT_APIGATEWAY=6379
REDIS_PASSWORD_APIGATEWAY=change-me
REDIS_DB_APIGATEWAY=0

REDIS_HOST_AUTH=redis-auth
REDIS_PORT_AUTH=6379
REDIS_PASSWORD_AUTH=change-me
REDIS_DB_AUTH=0

REDIS_HOST_USER=redis-user
REDIS_PORT_USER=6379
REDIS_PASSWORD_USER=change-me
REDIS_DB_USER=0

REDIS_HOST_ROLE=redis-role
REDIS_PORT_ROLE=6379
REDIS_PASSWORD_ROLE=change-me
REDIS_DB_ROLE=0

REDIS_HOST_CARD=redis-card
REDIS_PORT_CARD=6379
REDIS_PASSWORD_CARD=change-me
REDIS_DB_CARD=0

REDIS_HOST_MERCHANT=redis-merchant
REDIS_PORT_MERCHANT=6379
REDIS_PASSWORD_MERCHANT=change-me
REDIS_DB_MERCHANT=0

REDIS_HOST_SALDO=redis-saldo
REDIS_PORT_SALDO=6379
REDIS_PASSWORD_SALDO=change-me
REDIS_DB_SALDO=0

REDIS_HOST_TOPUP=redis-topup
REDIS_PORT_TOPUP=6379
REDIS_PASSWORD_TOPUP=change-me
REDIS_DB_TOPUP=0

REDIS_HOST_TRANSACTION=redis-transaction
REDIS_PORT_TRANSACTION=6379
REDIS_PASSWORD_TRANSACTION=change-me
REDIS_DB_TRANSACTION=0

REDIS_HOST_TRANSFER=redis-transfer
REDIS_PORT_TRANSFER=6379
REDIS_PASSWORD_TRANSFER=change-me
REDIS_DB_TRANSFER=0

REDIS_HOST_WITHDRAW=redis-withdraw
REDIS_PORT_WITHDRAW=6379
REDIS_PASSWORD_WITHDRAW=change-me
REDIS_DB_WITHDRAW=0

# Redis Cluster (6 nodes) — used when REDIS_CLUSTER_ENABLED=true
REDIS_CLUSTER_ENABLED=true
REDIS_CLUSTER_ENDPOINTS=redis-node-1:6379,redis-node-2:6379,redis-node-3:6379,redis-node-4:6379,redis-node-5:6379,redis-node-6:6379
REDIS_PASSWORD=change-me

# ── App / Security ───────────────────────────────────────────────────────────
DB_SEEDER=false
SECRET_KEY=change-me
# HS256 signing key for JWT. Must be >= 32 chars (RFC 7518 §3.2).
# Generate per environment with: openssl rand -base64 48
JWT_SECRET=change-me-at-least-32-characters-long-0123456789
DB_URL=postgres://change-me:change-me@postgres:5432/PAYMENT_GATEWAY

# ── Kafka / Observability ────────────────────────────────────────────────────
KAFKA_BROKERS=kafka:9092
APP_LOGGER=production
OTEL_ENDPOINT=otel-collector:4317

# ── gRPC service addresses (docker network) ──────────────────────────────────
GRPC_AUTH_ADDR=auth:50051
GRPC_ROLE_ADDR=role:50052
GRPC_CARD_ADDR=card:50053
GRPC_MERCHANT_ADDR=merchant:50054
GRPC_USER_ADDR=user:50055
GRPC_SALDO_ADDR=saldo:50056
GRPC_TOPUP_ADDR=topup:50057
GRPC_TRANSACTION_ADDR=transaction:50058
GRPC_TRANSFER_ADDR=transfer:50059
GRPC_WITHDRAW_ADDR=withdraw:50060

GRPC_AUTH_PORT=50051
GRPC_ROLE_PORT=50052
GRPC_CARD_PORT=50053
GRPC_MERCHANT_PORT=50054
GRPC_USER_PORT=50055
GRPC_SALDO_PORT=50056
GRPC_TOPUP_PORT=50057
GRPC_TRANSACTION_PORT=50058
GRPC_TRANSFER_PORT=50059
GRPC_WITHDRAW_PORT=50060

# ── SMTP ─────────────────────────────────────────────────────────────────────
# Use a test inbox (e.g. Ethereal) or real SMTP credentials here.
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USER=change-me
SMTP_PASS=change-me
